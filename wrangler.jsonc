{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-tracker",
  "main": "worker.py",
  "account_id": "1de4a616109adadae2537a0c24db384c",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "gym.dariushshaban.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-tracker",
      "database_id": "335bc117-6df3-407f-bd79-91ca41633d12"
    }
  ]
}
